# Copy to .env and fill in real values. Never commit .env.

PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string

# ─── Primary datastore: Supabase Postgres ─────────────────────────────────────
# Which backend config/db.js uses. Set to 'firestore' to roll back to the old
# Firebase database without changing any application code.
DB_PROVIDER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key — safe for the browser. RLS is enabled with zero policies, so
# it cannot read any table.
SUPABASE_ANON_KEY=
# Server-side only. NEVER commit this, never expose it to a browser, never
# send it to a third party. Rotating: Supabase → Settings → API Keys → Reset.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Firebase: IDENTITY provider only (email/password sign-in) ────────────────
# Firestore and the Realtime Database are both no longer used as the datastore.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/v3/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Outgoing mail (backup-download OTP + password reset) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=