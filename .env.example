# Copy to .env and fill in real values. Never commit .env.

PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string

# ─── Primary datastore: Supabase Postgres ─────────────────────────────────────
# Which backend config/db.js uses. Set to 'firestore' to roll back to the old
# Firebase database without changing any application code.
DB_PROVIDER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key — safe for the browser. RLS is enabled with zero policies, so
# it cannot read any table.
SUPABASE_ANON_KEY=
# Server-side only. NEVER commit this, never expose it to a browser, never
# send it to a third party. Rotating: Supabase → Settings → API Keys → Reset.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Firebase: IDENTITY provider only (email/password sign-in) ────────────────
# Firestore and the Realtime Database are both no longer used as the datastore.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/v3/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Outgoing mail (signup OTP, password reset, backup OTP) ────────────────────
# PRIMARY transport — Brevo transactional HTTP API. Plain HTTPS on :443, so it
# works from Railway/Render/Fly. Gmail's SMTP server on :587 is NOT reachable
# from those hosts: the TCP connection hangs until nodemailer's timeout, which
# looks like "OTP failed to send" even though the app is otherwise healthy.
# Get the key from Brevo → SMTP & API → API Keys. The sender address must be
# verified in the Brevo account, otherwise every send fails with HTTP 400.
# Free tier: 300 emails/day.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
MAIL_FROM_NAME=OBA System

# FALLBACK transport — only used when BREVO_API_KEY is empty. Do not configure
# this on Railway. EMAIL_PASS must be a 16-character Google app password with
# NO spaces (Google displays it in groups of four; strip them).
# SendGrid equivalent: SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Absolute base URL of the deployed site. Used to build password-reset links so
# they cannot be poisoned via the Host header. Set this in production.
APP_BASE_URL=